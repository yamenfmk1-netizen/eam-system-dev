# Supabase — من Project Settings > API في لوحة تحكم Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# مطلوب فقط للسكربتات الإدارية (seed / حذف مستخدمين) - لا تستخدمه أبدًا في كود الواجهة
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# اسم التطبيق (اختياري)
NEXT_PUBLIC_APP_NAME="نظام إدارة الأصول الكهربائية والصيانة"

# رابط الموقع الفعلي بعد النشر (مثال: https://your-project.vercel.app)
# يُستخدم لأي روابط مطلقة مستقبلية (مثل روابط البريد الإلكتروني لإعادة تعيين كلمة المرور)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Upstash Redis — لـ Rate Limiting موزَّع وموثوق على Vercel Serverless
# (بدونهما، النظام يعمل بحد In-Memory احتياطي غير موثوق عبر نسخ الخادم المتعددة —
# راجع lib/rate-limit/index.ts). أنشئ قاعدة مجانية على https://upstash.com
# (Redis → Create Database → REST API)، وانسخ القيمتين من صفحة القاعدة مباشرة.
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_DEPARTMENT_CODE=electrical
